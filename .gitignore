# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Next.js / build output ──────────────────────────────────────────────────
.next/
out/
build/
*.tsbuildinfo
# Auto-generated by `next dev`/`next build`; not source.
next-env.d.ts

# ─── Environment ─────────────────────────────────────────────────────────────
# Real connection strings stay local. The tracked template is app/.env.example.
.env
.env.local
.env*.local

# ─── Credentials ─────────────────────────────────────────────────────────────
# Playwright storageState from scrape.mjs — a live xfusion.pro SESSION TOKEN.
# Never commit this.
auth.json
scraper/auth.json

# ─── Scraped payloads (third-party content — see README) ─────────────────────
# scraper/snapshot/api/*.json IS tracked: it's the seed source of truth.
# Everything below is re-fetchable via the scraper and stays out of git:
#   _data/  — 939 Next.js RSC payloads captured by the Playwright crawl (noise)
#   html/   — raw rendered pages, visual reference only
#   assets/ — xfusion's S3 logos/PDFs (the 3 logos the app serves live in
#             app/public/logos/, which IS tracked)
scraper/snapshot/_data/
scraper/snapshot/html/
scraper/snapshot/assets/
# Authenticated crawl (scrape-auth.mjs) — xfusion's content from behind their
# login. Never commit this.
scraper/snapshot/auth-html/
scraper/snapshot/auth-shots/
scraper/snapshot/auth-routes.json

# ─── Spec documents (proprietary — kept local, see docs/README.md) ───────────
docs/*.pdf
docs/*.docx
docs/*.doc

# ─── Editor / OS cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.pem

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel
