{
  "name": "xfusion-scraper",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "fetch": "node fetch-api.mjs",
    "assets": "node download-assets.mjs",
    "scrape": "node scrape.mjs",
    "login": "node login.mjs",
    "scrape:auth": "node scrape-auth.mjs",
    "sync": "cp snapshot/api/*.json ../app/data/",
    "refresh": "npm run fetch && npm run assets && npm run sync"
  },
  "dependencies": {
    "playwright": "^1.61.1"
  }
}
