# Copy to `.env` and adjust for your machine:  cp .env.example .env
#
# Local Postgres. Create the DB once with:  createdb xfusion_clone
# Then:  npm run db:push && npm run db:seed
DATABASE_URL="postgresql://USER@localhost:5432/xfusion_clone?schema=public"

# Gemini API key (Google AI / Google Cloud) — powers the 2.0 AI challenge
# intake at /challenges/new. Without it the chat shows a clear config error.
# Restart `npm run dev` after changing this.
GEMINI_API_KEY=""
# Optional; defaults to gemini-2.5-flash
# GEMINI_MODEL="gemini-2.5-flash"
