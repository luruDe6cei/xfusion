# Copy to `.env` and adjust for your machine:  cp .env.example .env
#
# Local Postgres. Create the DB once with:  createdb xfusion_clone
# Then:  npm run db:push && npm run db:seed
DATABASE_URL="postgresql://USER@localhost:5432/xfusion_clone?schema=public"

# Gemini API key (Google AI / Google Cloud) — powers the Challenge Wizard's
# AI (chat dock, ✨ improve, Help Me Write, tips) at /dashboard/challenges/new.
# Without it the AI features show a clear config error.
# Restart `npm run dev` after changing this.
GEMINI_API_KEY=""
# Optional; defaults to gemini-2.5-flash
# GEMINI_MODEL="gemini-2.5-flash"
# Optional; upstream request timeout in ms (default 120000)
# GEMINI_TIMEOUT_MS="120000"
# Optional; Gemini 2.5 "thinking" token budget (default 0 = disabled — fast).
# gemini-2.5-flash accepts 0; 2.5 Pro requires >=128.
# GEMINI_THINKING_BUDGET="0"
